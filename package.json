    "chalk": "4",
    "eslint": "^10.0.3",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.42.0",
    "oxlint-tsgolint": "^0.18.1",
    "tsdown": "^0.21.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
