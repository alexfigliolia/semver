    "cli",
    "developer tool",
    "semver"
  ],
  "homepage": "https://github.com/alexfigliolia/semver#readme",
  "license": "MIT",
  "author": "Alex Figliolia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexfigliolia/semver.git"
  },
  "bin": {
    "release": "./dist/CLI.mjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "main": "./dist/index.mjs",
